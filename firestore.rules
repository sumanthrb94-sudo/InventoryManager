rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MOBILEPHONEMARKET — Firestore security rules
//
// Auth model: shared team ownership. Every record carries
// `ownerId: 'shared'` so the whole team reads/writes one dataset. These
// rules tighten the previously-loose `if isSignedIn()` policy by:
//
//   1. Validating ownerId='shared' on every create/update — prevents a
//      signed-in user from spraying records with a poisoned ownerId.
//   2. Hard-blocking deletes on AUDIT-ONLY collections (sales,
//      inventoryEvents, importBatches, sourceDocuments). The void / soft-
//      delete paths use UPDATE instead of DELETE by design, so a real
//      delete is a bug or an attack.
//   3. Gating writes to reference / admin-managed collections
//      (marketplaceFees) to the admin email only.
//   4. Final catch-all `match /{document=**}` denies everything not
//      explicitly listed above so an accidentally-created collection
//      can't be reached without a rules update.
//
// Anything that needs per-user ownership later (e.g. a user-specific
// settings collection) should grow its own rule block — don't loosen
// the shared rule to accommodate it.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin allowlist — single source of truth. Keep in sync with
    // ADMIN_EMAILS in src/lib/firebase.ts (UX gate). The rules layer is
    // the real boundary; the UX gate is just a hint.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'admin@inventorymanager.com',
          'sumanthbolla97@gmail.com',
        ];
    }

    // Treat 'shared' as the only valid ownerId value the team writes. The
    // matching check accepts either a freshly-written 'shared' or the
    // doc keeping its existing 'shared' value through an update.
    function ownsShared() {
      return request.resource.data.ownerId == 'shared';
    }

    // For updates we also tolerate the doc not carrying ownerId at all
    // (some legacy imports skipped it) — but the new state must still
    // resolve to 'shared'.
    function staysShared() {
      return !('ownerId' in request.resource.data)
        || request.resource.data.ownerId == 'shared';
    }

    // ── Inventory + buy side ───────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /batches/{batchId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /inventoryUnits/{unitId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      // Delete normally happens via supplier-return SOFT-DELETE (status
      // flip + returnType), not hard delete. Restrict hard deletes to
      // admin so a stray service-side bug can't wipe a unit doc.
      allow delete: if isAdmin();
    }
    match /activeListings/{listingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isSignedIn();
    }
    match /dailyUpdates/{updateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }

    // ── Sales + audit collections ──────────────────────────────────────────
    // sales: voided sales must persist for audit. The void path UPDATES
    // (voidedAt + voidOutcome). A delete is a bug — block everywhere except
    // admin maintenance.
    match /sales/{saleId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /inventoryEvents/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      // The audit log is append-and-correct only. No client edits / deletes.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /importBatches/{batchId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /sourceDocuments/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      // Source documents are the audit trail of imports — admin only.
      allow delete: if isAdmin();
    }
    match /inventoryAggregates/{aggregateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /supplierWhatsappUpdates/{updateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isSignedIn();
    }

    // ── Reference / admin-managed collections ──────────────────────────────
    // marketplaceFees: commission rates, postage defaults, VAT tier — the
    // operator should never edit these from a client device. Reads open
    // to all signed-in users; writes admin-only.
    match /marketplaceFees/{marketplace} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin();
    }

    // Notices: admin-authored team broadcast board (date-stamped posts
    // visible to every signed-in employee). Treat like marketplaceFees:
    // everyone reads, only the admin email writes. Per-doc ownerId still
    // resolves to 'shared' so create/update share the same shape as the
    // rest of the dataset.
    match /notices/{noticeId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() && ownsShared();
      allow update: if isAdmin() && staysShared();
      allow delete: if isAdmin();
    }

    // Models: admin-curated catalog of (brand, model) pairs. Employees
    // can only PICK from this list in Add Stock / Bulk Order (the
    // strict DeviceComboBox + isAdmin gate enforces this client-side).
    // Reads open to every signed-in user so the picker can render the
    // dropdown; writes (incl. new-model add from the "+ Add" pill) are
    // admin-only.
    match /models/{modelId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() && ownsShared();
      allow update: if isAdmin() && staysShared();
      allow delete: if isAdmin();
    }

    // ── Default deny — every unlisted collection is blocked. ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
