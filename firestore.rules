rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }
    match /batches/{batchId} {
      allow read, write: if isSignedIn();
    }
    match /inventoryUnits/{unitId} {
      allow read, write: if isSignedIn();
    }
    match /inventoryEvents/{eventId} {
      allow read, write: if isSignedIn();
    }
    match /dailyUpdates/{updateId} {
      allow read, write: if isSignedIn();
    }
    match /activeListings/{listingId} {
      allow read, write: if isSignedIn();
    }
    match /sourceDocuments/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Master-files audit collections ─────────────────────────────────────
    match /importBatches/{batchId} {
      allow read, write: if isSignedIn();
    }
    match /sales/{saleId} {
      allow read, write: if isSignedIn();
    }
    match /inventoryAggregates/{aggregateId} {
      allow read, write: if isSignedIn();
    }
    match /marketplaceFees/{marketplace} {
      allow read: if isSignedIn();
      // Reference data — also writable by signed-in admins to seed/update.
      allow write: if isSignedIn();
    }
    match /supplierWhatsappUpdates/{updateId} {
      allow read, write: if isSignedIn();
    }

    // Per-IMEI return lifecycle (returned → restocked → sent_to_supplier →
    // received_again …). Without this rule the catch-all below denied every
    // read/write, so the timeline only lived in the in-memory cache and
    // vanished on reload — the per-IMEI date-wise history never persisted.
    match /returnEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    // Append-only admin audit trail (who created/updated/deleted what).
    // Previously denied by the catch-all, so the Admin "Audit Log" panel
    // always read empty after a reload even though writes were attempted.
    match /auditLog/{entryId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
