rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MOBILEPHONEMARKET — Firestore security rules
//
// Auth model: shared team ownership. Every record carries
// `ownerId: 'shared'` so the whole team reads/writes one dataset. These
// rules tighten the previously-loose `if isSignedIn()` policy by:
//
//   1. Validating ownerId='shared' on every create/update — prevents a
//      signed-in user from spraying records with a poisoned ownerId.
//   2. Hard-blocking deletes on AUDIT-ONLY collections (sales,
//      inventoryEvents, importBatches, sourceDocuments). The void / soft-
//      delete paths use UPDATE instead of DELETE by design, so a real
//      delete is a bug or an attack.
//   3. Gating writes to reference / admin-managed collections
//      (marketplaceFees) to the admin email only.
//   4. Final catch-all `match /{document=**}` denies everything not
//      explicitly listed above so an accidentally-created collection
//      can't be reached without a rules update.
//
// Anything that needs per-user ownership later (e.g. a user-specific
// settings collection) should grow its own rule block — don't loosen
// the shared rule to accommodate it.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin allowlist — single source of truth. Keep in sync with
    // ADMIN_EMAILS in src/lib/firebase.ts (UX gate). The rules layer is
    // the real boundary; the UX gate is just a hint.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          'admin@inventorymanager.com',
          'sumanthbolla97@gmail.com',
          'sai@inventorymanager.com',
        ];
    }

    // Returns-manager allowlist. Keep in sync with isReturnsManager() in
    // src/lib/firebase.ts. Admins are implicitly returns managers.
    function isReturnsManager() {
      return isAdmin()
        || (
          isSignedIn()
          && request.auth.token.email in [
            // TODO: populate returns-manager emails
          ]
        );
    }

    // True when this write puts a doc INTO a return state.
    //
    // THE BUG THIS REPLACES, AND WHY IT WAS INVISIBLE
    //
    // The old version asked whether a field was PRESENT:
    //   'returnType' in request.resource.data
    // On an update, request.resource.data is the document as it will exist
    // AFTER the write — the merged result, not the delta. So the check fired
    // for any unit that merely CARRIED the key, whatever its value.
    //
    // recordSale's unit patch deliberately writes returnType / returnDate /
    // returnReason / returnOutcome / returnLegCost / returnComments as NULL,
    // to clear stale return state when a unit starts a fresh sale cycle. That
    // made every sale look like a return update, so marking a unit sold was
    // allowed only for a returns manager — and that allowlist is empty, which
    // leaves the three admin emails. Every sales-team member marking stock
    // sold had the inventoryUnits write denied while the sale doc itself
    // (governed by its own rule) went through, and dbService swallowed the
    // denial. The result on screen: "10 sold", with the units still showing as
    // available in inventory and on every dashboard after a refresh.
    //
    // A return update is now one that CHANGES one of these fields TO a real
    // value. Clearing them to null on a sale is not one. Leaving a previously
    // repaired unit's repairedAt untouched while selling it again is not one
    // either — that was the second false positive hiding behind the first.
    function changedToNonNull(f) {
      return request.resource.data.get(f, null) != null
        && request.resource.data.get(f, null) != resource.data.get(f, null);
    }
    function isReturnUpdate() {
      return (
        (request.resource.data.get('status', '') == 'returned'
          && resource.data.get('status', '') != 'returned')
        || changedToNonNull('returnType')
        || changedToNonNull('returnOutcome')
        || changedToNonNull('returnLegCost')
        || changedToNonNull('returnQcAt')
        || changedToNonNull('replacedByUnitId')
        || changedToNonNull('replacementForUnitId')
        || changedToNonNull('repairedAt')
        // The 2026-08 return-cost fields. Money entered after the fact —
        // the repair invoice, the second handset a replacement cost, the
        // supplier's settlement — so they belong behind the same returns
        // gate as the rest of the return record, not open to any signed-in
        // user. Same changedToNonNull shape: clearing repairCost to null at
        // the start of a new return cycle must not count as a return update,
        // or re-selling a previously repaired unit is denied all over again.
        || changedToNonNull('repairCost')
        || changedToNonNull('replacementUnitCost')
        || changedToNonNull('supplierCreditAmount')
        || changedToNonNull('supplierCreditDate')
        || changedToNonNull('supplierCreditType')
        || changedToNonNull('voidedAt')
        || changedToNonNull('voidOutcome')
        || changedToNonNull('voidReason')
        || (request.resource.data.get('pendingCrmReview', false) == true
          && resource.data.get('pendingCrmReview', false) != true)
      );
    }

    // Treat 'shared' as the only valid ownerId value the team writes. The
    // matching check accepts either a freshly-written 'shared' or the
    // doc keeping its existing 'shared' value through an update.
    function ownsShared() {
      return request.resource.data.ownerId == 'shared';
    }

    // For updates we also tolerate the doc not carrying ownerId at all
    // (some legacy imports skipped it) — but the new state must still
    // resolve to 'shared'.
    function staysShared() {
      return !('ownerId' in request.resource.data)
        || request.resource.data.ownerId == 'shared';
    }

    // ── Inventory + buy side ───────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /batches/{batchId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /inventoryUnits/{unitId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared() && (!isReturnUpdate() || isReturnsManager());
      // Delete normally happens via supplier-return SOFT-DELETE (status
      // flip + returnType), not hard delete. Restrict hard deletes to
      // admin so a stray service-side bug can't wipe a unit doc.
      allow delete: if isAdmin();
    }
    match /activeListings/{listingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isSignedIn();
    }
    match /dailyUpdates/{updateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }

    // ── Sales + audit collections ──────────────────────────────────────────
    // sales: voided sales must persist for audit. The void path UPDATES
    // (voidedAt + voidOutcome). A delete is a bug — block everywhere except
    // admin maintenance.
    match /sales/{saleId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared() && (!isReturnUpdate() || isReturnsManager());
      allow delete: if isAdmin();
    }
    match /inventoryEvents/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      // The audit log is append-and-correct only. No client edits / deletes.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /importBatches/{batchId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    match /sourceDocuments/{docId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      // Source documents are the audit trail of imports — admin only.
      allow delete: if isAdmin();
    }
    match /inventoryAggregates/{aggregateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    // accessoryStock: quantity-pool stock for no-IMEI items (chargers, SIM
    // pins). Same shape as inventoryAggregates — a shared rollup doc per
    // SKU, topped up at Add Stock and decremented by the sales importer.
    match /accessoryStock/{skuId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isAdmin();
    }
    // accessoryStockEvents: the transaction ledger behind accessoryStock's
    // running quantity (topup/sale/adjustment/return/restore) — append-and-
    // correct only, same convention as inventoryEvents.
    match /accessoryStockEvents/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /supplierWhatsappUpdates/{updateId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && ownsShared();
      allow update: if isSignedIn() && staysShared();
      allow delete: if isSignedIn();
    }

    // ── Reference / admin-managed collections ──────────────────────────────
    // marketplaceFees: commission rates, postage defaults, VAT tier — the
    // operator should never edit these from a client device. Reads open
    // to all signed-in users; writes admin-only.
    match /marketplaceFees/{marketplace} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin();
    }

    // Notices: admin-authored team broadcast board (date-stamped posts
    // visible to every signed-in employee). Treat like marketplaceFees:
    // everyone reads, only the admin email writes. Per-doc ownerId still
    // resolves to 'shared' so create/update share the same shape as the
    // rest of the dataset.
    match /notices/{noticeId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() && ownsShared();
      allow update: if isAdmin() && staysShared();
      allow delete: if isAdmin();
    }

    // Models: admin-curated catalog of (brand, model) pairs. Employees
    // can only PICK from this list in Add Stock / Bulk Order (the
    // strict DeviceComboBox + isAdmin gate enforces this client-side).
    // Reads open to every signed-in user so the picker can render the
    // dropdown; writes (incl. new-model add from the "+ Add" pill) are
    // admin-only.
    match /models/{modelId} {
      allow read:   if isSignedIn();
      allow create: if isAdmin() && ownsShared();
      allow update: if isAdmin() && staysShared();
      allow delete: if isAdmin();
    }

    // ── Default deny — every unlisted collection is blocked. ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
