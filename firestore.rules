rules_version = '2';

// Internal inventory tool. Access is restricted to a hard-coded list of
// authorised staff accounts (email/password sign-in via Firebase Auth).
// Edit the email list in `isAdmin()` below before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Replace the placeholder addresses with the real staff accounts
    // before deploying. Auth provider: Firebase email/password.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
             'owner@mobilephonemarket.example',
             'ops@mobilephonemarket.example'
           ];
    }

    // Operational collections — full read/write for admins only.
    match /suppliers/{supplierId}        { allow read, write: if isAdmin(); }
    match /batches/{batchId}             { allow read, write: if isAdmin(); }
    match /inventoryUnits/{unitId}       { allow read, write: if isAdmin(); }
    match /inventoryEvents/{eventId}     { allow read, write: if isAdmin(); }
    match /dailyUpdates/{updateId}       { allow read, write: if isAdmin(); }
    match /activeListings/{listingId}    { allow read, write: if isAdmin(); }
    match /sourceDocuments/{docId}       { allow read, write: if isAdmin(); }

    // SHS removal audit log — written from StockInPage when pending SHS
    // groups are removed; read by StockTickerBoard for the live tape.
    match /shsRemovals/{removalId}       { allow read, write: if isAdmin(); }

    // Catch-all: deny anything we haven't explicitly authorised.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
