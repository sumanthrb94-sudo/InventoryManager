rules_version = '2';

// ⚠️ DEMO MODE — open rules.
//
// Auth is bypassed in the client right now (universal access, no login).
// To keep the production demo fully functional (live reads + writes) we
// also temporarily open Firestore. ANYONE WHO CAN HIT THE URL CAN READ
// AND WRITE EVERYTHING. Revert to the locked version (see git history)
// the moment auth is back on.
service cloud.firestore {
  match /databases/{database}/documents {
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /batches/{batchId} {
      allow read, write: if true;
    }
    match /inventoryUnits/{unitId} {
      allow read, write: if true;
    }
    match /inventoryEvents/{eventId} {
      allow read, write: if true;
    }
    match /dailyUpdates/{updateId} {
      allow read, write: if true;
    }
    match /activeListings/{listingId} {
      allow read, write: if true;
    }
    match /sourceDocuments/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
