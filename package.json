{
  "name": "mobilephonemarket-inventory-manager",
  "private": true,
  "version": "1.0.0",
  "description": "MOBILEPHONEMARKET — Production Inventory Management System",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "import": "node import_excel.cjs",
    "import:help": "node import_excel.cjs --help",
    "import:dry": "node import_excel.cjs --dry-run --verbose",
    "import:sample": "node import_excel.cjs --file SAMPLE_INVENTORY_REPORT_2026.xlsx --verbose --public public/imported_inventory.json",
    "import:og": "node import_og_data.cjs",
    "import:og:dry": "node import_og_data.cjs --dry-run --verbose",
    "inject": "node inject_to_localstorage.cjs",
    "inject:imported": "node inject_to_localstorage.cjs --input imported_inventory.json",
    "seed:public": "node import_excel.cjs --file SAMPLE_INVENTORY_REPORT_2026.xlsx --public public/imported_inventory.json",
    "py:convert": "python convert_excel.py",
    "py:import": "python convert_excel.py --file SAMPLE_INVENTORY_REPORT_2026.xlsx --output public/imported_inventory.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "users:provision": "node scripts/create-team-users.cjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.12.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^5.1.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.9.0",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.6",
    "xlsx": "^0.18.5"
  }
}
