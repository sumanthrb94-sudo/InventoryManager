node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Firebase admin credentials & team passwords — never commit.
firebase-service-account.json
firebase-service-account*.json
scripts/team-passwords.json
__pycache__/
imported_inventory.json

# Temporary build artefact emitted by `npx vitest list` and consumed by
# scripts/build-test-report-docx.mjs. Regenerated on every report build.
.test-list.txt

# E2E harness artefacts
dist-e2e/

# e2e-screenshots/ is COMMITTED, deliberately. The suites record what was
# verified; the screenshots record what it looked like. They cost ~31 MB and
# every e2e*.mjs runner overwrites them in place, so re-running a suite and
# committing produces a diff of only what actually changed on screen.
