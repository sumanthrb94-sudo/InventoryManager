# ═══════════════════════════════════════════════════════════════════════════════
# MOBILEPHONEMARKET — Inventory Manager
# Environment Variables Reference
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (optional secondary store used by Vercel API routes) ─────────────
# Required only if you deploy the /api/* serverless routes.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# ── Vercel API auth ───────────────────────────────────────────────────────────
# Comma-separated allow-list of admin emails. Callers must present a verified
# Firebase ID token whose `email` is in this list.
ADMIN_EMAILS=""
# Service account JSON for firebase-admin (paste the full JSON on one line).
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Comma-separated origins allowed to call the API (no trailing slash).
# e.g. "https://app.mobilephonemarket.com,https://staging.mobilephonemarket.com"
CORS_ALLOWED_ORIGINS=""

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Required for AI-powered features (auto-generated in AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Cloudinary (IMAGE STORAGE) ────────────────────────────────────────────────────
# Cloud Name: diofyOvxc (for unsigned uploads to free tier)
# To create an upload preset:
# 1. Go to Cloudinary Dashboard → Settings → Upload
# 2. Click "Add upload preset"
# 3. Name it "stock_intake" (or your preferred name)
# 4. Set Mode to "Unsigned"
# 5. Save and use the name below (defaults to "stock_intake")
VITE_CLOUDINARY_PRESET="stock_intake"

# ── App URL ──────────────────────────────────────────────────────────────────────
# The URL where this app is hosted (used for OAuth callbacks, links, etc.)
APP_URL="http://localhost:3000"

# ── Master Excel Import ───────────────────────────────────────────────────────────
# Override the master Excel file path for CLI import scripts.
# Takes priority over client.config.js masterExcel.filePath
# Leave blank to use auto-discovery from client.config.js nameHints.
MASTER_EXCEL_PATH=""

# Override the sheet name to import (leave blank for auto-detection)
IMPORT_SHEET_NAME=""

# Override the output JSON path (leave blank for default: imported_inventory.json)
IMPORT_OUTPUT_PATH=""

# ── Firebase (override only if not using firebase-applet-config.json) ─────────────
# These are automatically read from firebase-applet-config.json.
# Only set these if you're running in an environment without that file.
# FIREBASE_API_KEY=""
# FIREBASE_AUTH_DOMAIN=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_MESSAGING_SENDER_ID=""
# FIREBASE_APP_ID=""
# FIRESTORE_DATABASE_ID=""

# ── Client Overrides ──────────────────────────────────────────────────────────────
# These override the equivalent values in client.config.js
# BUSINESS_NAME="MOBILEPHONEMARKET"
# BUSINESS_CURRENCY="£"
# FIREBASE_OWNER_ID="shared"
