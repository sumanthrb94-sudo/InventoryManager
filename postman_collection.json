        {
          "name": "Get Sold Units with Profit Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Sold units have correct profit calculation', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function(unit) {",
                  "        if (unit.salePrice && unit.buyPrice) {",
                  "            var expectedProfit = unit.salePrice - unit.buyPrice - (unit.postageCost || 8) - (unit.platformFee || 0);",
                  "            var actualProfit = unit.profit;",
                  "            pm.expect(Math.abs(expectedProfit - actualProfit)).to.be.below(1);",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventory?status=sold&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory"],
              "query": [
                {
                  "key": "status",
                  "value": "sold"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
