    {
      "name": "Analytics & Reporting",
      "item": [
        {
          "name": "Get Overall Analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Analytics has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalRevenue');",
                  "    pm.expect(jsonData).to.have.property('totalCost');",
                  "    pm.expect(jsonData).to.have.property('grossProfit');",
                  "    pm.expect(jsonData).to.have.property('stockValue');",
                  "    pm.expect(jsonData).to.have.property('availableCount');",
                  "    pm.expect(jsonData).to.have.property('soldCount');",
                  "});",
                  "pm.test('Profit is calculated correctly', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.grossProfit).to.equal(jsonData.totalRevenue - jsonData.totalCost - jsonData.totalPostage);",
                  "});",
                  "pm.test('Revenue is positive or zero', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalRevenue).to.be.above(-1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics"]
