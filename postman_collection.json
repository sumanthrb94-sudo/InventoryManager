    {
      "name": "Data Integrity Tests",
      "item": [
        {
          "name": "Verify No Duplicate IMEIs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('No duplicate IMEIs in available units', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var imeis = jsonData.filter(u => u.imei).map(u => u.imei);",
                  "    var uniqueImeis = new Set(imeis);",
                  "    pm.expect(imeis.length).to.equal(uniqueImeis.size);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventory?status=available&limit=500",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory"],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                },
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Verify All Units Have Valid Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All units have valid status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var validStatuses = ['available', 'sold', 'returned', 'incoming'];",
                  "    jsonData.forEach(function(unit) {",
                  "        pm.expect(validStatuses).to.include(unit.status);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventory?limit=500",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory"],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Inventory Stock Value Matches Analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/inventory?status=available&limit=500',",
                  "    method: 'GET'",
                  "}, function(err, response) {",
                  "    var units = response.json();",
                  "    var stockValue = units.reduce((sum, u) => sum + (u.buyPrice || 0), 0);",
                  "    ",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get('base_url') + '/api/analytics',",
                  "        method: 'GET'",
                  "    }, function(err2, analyticsResponse) {",
                  "        var analytics = analyticsResponse.json();",
                  "        pm.test('Stock value matches analytics', function() {",
                  "            pm.expect(Math.abs(stockValue - analytics.stockValue)).to.be.below(1);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventory?status=available&limit=1",
              "host": ["{{base_url}}"],
              "path": ["api", "inventory"],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
